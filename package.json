{
  "name": "dsh-youtube-scroll",
  "version": "1.0.0",
  "type": "module",
  "description": "DSH 插件：每天替你刷一輪 YouTube —— 訂閱頻道＋關鍵詞、讀字幕（沒字幕用本機 Whisper）、縮圖輔助，寫繁體中文日報；也可貼單條連結做完整解讀。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "mcp",
    "prompts",
    "locale/*.json",
    "icon.svg",
    "lib",
    "test",
    "DESIGN.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "youtube",
    "mcp",
    "transcript",
    "whisper",
    "daily-report",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/mcp.test.mjs"
  }
}