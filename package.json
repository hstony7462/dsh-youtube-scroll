{
  "name": "dsh-youtube-scroll",
  "version": "1.0.5",
  "type": "module",
  "description": "DSH 插件：每天替你刷一輪 YouTube —— 訂閱頻道＋關鍵詞、讀字幕（沒字幕用本機 Whisper）、縮圖輔助，寫繁體中文日報；也可貼單條連結做完整解讀。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "locale/*.json",
    "icon.svg",
    "mcp/server.mjs",
    "mcp/asr.py",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "youtube",
    "mcp",
    "transcript",
    "whisper",
    "daily-report",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "test:live": "node test/mcp.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check mcp/server.mjs && node --check lib/mcp-call.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hstony7462/dsh-youtube-scroll.git"
  },
  "homepage": "https://github.com/hstony7462/dsh-youtube-scroll#readme",
  "bugs": {
    "url": "https://github.com/hstony7462/dsh-youtube-scroll/issues"
  }
}